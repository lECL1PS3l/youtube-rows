{
  "manifest_version": 3,
  "name": "YouTube Rows",
  "version": "1.0.0",
  "description": "6 thumbnails per row on YouTube instead of 3",
  "permissions": ["storage", "scripting"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
